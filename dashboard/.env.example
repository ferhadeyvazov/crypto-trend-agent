# Backend API/socket.io ünvanı (dev: fixture server və ya npm run start).
VITE_API_URL=http://localhost:4000

# Backend .env-dəki CONTROL_TOKEN ilə EYNİ dəyər olmalıdır. Qeyd: Vite
# VITE_ dəyişənlərini client bundle-a AÇIQ şəkildə daxil edir — bu,
# gizli sirr kimi qorunmur, yalnız "səhvən klik" qarşısını alan Confirm
# dialoqu ilə birlikdə işləyir (tək-istifadəçi yerli deployment).
VITE_CONTROL_TOKEN=dev-token

# Dashboard REST API-nin yazma (control) endpoint-lərini qoruyan token.
# POST /api/engine/start və /api/engine/stop çağırışları bu dəyəri
# `X-Control-Token` header-ində gözləyir.
CONTROL_TOKEN=change-me

# Express API-nin dinlədiyi port.
PORT=4000

# Telegram Bridge (Mərhələ 9). @BotFather ilə yaradılan bot tokeni — BOŞ olsa
# bridge tamamilə deaktiv qalır (proses çökmür). HEÇ VAXT koda yazma, yalnız bu faylda.
TELEGRAM_BOT_TOKEN=

# Yalnız bu chat ID-lər /status, /trades, /stop, /start əmrlərini verə bilər
# və bildirişləri alır. Vergüllə ayrılmış rəqəmlər (məs. öz chat ID-nizi
# @userinfobot ilə tapa bilərsiniz). Boş olsa bütün əmrlər rədd edilir.
ALLOWED_CHAT_IDS=
